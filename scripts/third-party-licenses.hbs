<!-- Generated by cargo-about. Do not edit the output directly. -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tokenx third-party licenses</title>
  <style>
    body { font: 14px/1.5 system-ui, sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; color: #18181b; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border-bottom: 1px solid #d4d4d8; padding: 0.4rem; text-align: left; vertical-align: top; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; border: 1px solid #d4d4d8; padding: 1rem; }
  </style>
</head>
<body>
  <h1>Tokenx third-party licenses</h1>
  <p>This document lists Rust dependencies distributed in Tokenx native binaries and their license terms.</p>
  <h2>Components</h2>
  <table>
    <thead><tr><th>Component</th><th>Version</th><th>License</th></tr></thead>
    <tbody>
    {{#each crates}}
      <tr>
        <td><a href="{{#if package.repository}}{{package.repository}}{{else}}https://crates.io/crates/{{package.name}}{{/if}}">{{package.name}}</a></td>
        <td>{{package.version}}</td>
        <td>{{license}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  <h2>License texts</h2>
  {{#each licenses}}
{{#if first_of_kind}}
    <h3 id="{{id}}">{{name}}</h3>
{{/if}}
    <h4>{{name}}</h4>
    <p>Used by:
      {{#each used_by}}{{crate.name}} {{crate.version}}{{#unless @last}}, {{/unless}}{{/each}}
    </p>
    <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
